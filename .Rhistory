View(oil_qtr)
#Measurement of oilshock
oil_qtr$oil_qrt_shock_positive <- ifelse(oil_qtr$oil_fst_diff <
(mean(oil_qtr$oil_fst_diff, na.rm = TRUE)
+ (2*sd(oil_qtr$oil_fst_diff, na.rm = TRUE)) )
,0,1)
oil_qtr$oil_qrt_shock_negative <- ifelse(oil_qtr$oil_fst_diff >
(mean(oil_qtr$oil_fst_diff, na.rm = TRUE)
- (2*sd(oil_qtr$oil_fst_diff, na.rm = TRUE)) )
,0,1)
